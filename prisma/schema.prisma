generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модель пользователя
model User {
  id             String   @id @default(cuid())
  login          String   @unique
  email          String   @unique
  password       String
  createdAt      DateTime @default(now())
  registrationIp String?
  emailVerified  Boolean  @default(false)
  isBlocked      Boolean  @default(false)
  balance        Float    @default(0)
  loyaltyPoints  Int      @default(0)
  loyaltyTier    String   @default("bronze") // bronze, silver, gold, platinum

  // Связи
  sessions       Session[]
  loginHistory   LoginHistory[]
  transactions   Transaction[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  bookings       Booking[]
  activityLogs   ActivityLog[]
  loyaltyRewards LoyaltyReward[]

  @@map("users")
}

model LoyaltyReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId]) // ДОБАВИТЬ индекс для производительности
  @@map("loyalty_rewards") // ДОБАВИТЬ mapping
}

// Модель сессии
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// История входов
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

// Транзакции пополнения
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  method    String // "yookassa", "card", "crypto", etc.
  status    String   @default("pending") // "pending", "success", "cancelled"
  details   String?  @db.Text // JSON с paymentId и другой информацией
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// Тикеты поддержки
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  category  String
  status    String   @default("open") // "open", "in_progress", "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@map("tickets")
}

// Сообщения в тикетах
model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String   @db.Text
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

// Зоны (VR, PS5, ПК и т.д.)
model Zone {
  id           String  @id @default(cuid())
  name         String  @unique
  type         String // "vr", "ps5", "pc-basic", "pc-pro", "pc-ultra", "vip"
  description  String
  pricePerHour Float
  totalSlots   Int
  imageUrl     String?
  isActive     Boolean @default(true)

  computers Computer[]
  bookings  Booking[]

  @@map("zones")
}

// Компьютеры/места
model Computer {
  id       String  @id @default(cuid())
  zoneId   String
  number   Int // номер компьютера в зоне
  isActive Boolean @default(true)

  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([zoneId, number])
  @@map("computers")
}

// Бронирования
model Booking {
  id         String   @id @default(cuid())
  userId     String
  zoneId     String
  computerId String?
  startTime  DateTime
  endTime    DateTime
  hours      Int
  totalPrice Float
  status     String   @default("active") // "active", "completed", "cancelled"
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  computer Computer? @relation(fields: [computerId], references: [id])

  @@map("bookings")
}

// Логи действий (для безопасности)
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "register", "login", "logout", "top_up", "booking", etc.
  details   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
